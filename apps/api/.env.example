# Kopyalayın: cp .env.example .env
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://emlook:emlook@localhost:5433/emlook

# Üretimde en az 32 karakterlik rastgele değerler kullanın:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=gelistirme-icin-degistirin-jwt
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

OTP_SECRET=gelistirme-icin-degistirin-otp
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_HOURLY_LIMIT=5

# console: kod API loguna yazılır (geliştirme)
SMS_PROVIDER=console

STORAGE_DIR=./uploads
MAX_UPLOAD_MB=10

# Virgülle ayrılmış izinli kaynaklar (web paneli)
CORS_ORIGINS=http://localhost:3001

KVKK_CLARIFICATION_VERSION=2026-11
TERMS_VERSION=2026-11

# `pnpm db:seed` bu numaraları yönetici yapar
ADMIN_PHONES=05320000000
