# Kopyalayın: cp .env.example .env
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://emlook:emlook@localhost:5433/emlook

# Üretimde en az 32 karakterlik rastgele değerler kullanın:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=gelistirme-icin-degistirin-jwt
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30

OTP_SECRET=gelistirme-icin-degistirin-otp
OTP_TTL_SECONDS=180
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_HOURLY_LIMIT=5

# console: kod API loguna yazılır (geliştirme) · netgsm: gerçek SMS (üretimde zorunlu)
SMS_PROVIDER=console
# NETGSM_USERCODE=8501234567
# NETGSM_PASSWORD=
# NETGSM_HEADER=EMLOOK          # Netgsm'de onaylı gönderici başlığı
# NETGSM_USE_OTP=true           # OTP paketi yoksa false (normal SMS ile gönderilir)

# local: STORAGE_DIR klasörü · s3: AWS S3 / Cloudflare R2 / MinIO (üretimde önerilir)
STORAGE_DRIVER=local
STORAGE_DIR=./uploads
# S3_BUCKET=emlook
# S3_REGION=auto                 # R2: auto · AWS: eu-central-1 gibi
# S3_ENDPOINT=https://<hesap>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false      # MinIO: true
# S3_PREFIX=prod/
MAX_UPLOAD_MB=10

# Virgülle ayrılmış izinli kaynaklar (web paneli)
CORS_ORIGINS=http://localhost:3001

KVKK_CLARIFICATION_VERSION=2026-11
TERMS_VERSION=2026-11

# `pnpm db:seed` bu numaraları yönetici yapar
ADMIN_PHONES=05320000000

# EİDS: mock (geliştirme) | manual (yönetici elle doğrular; üretim varsayılanı)
EIDS_PROVIDER=mock
MAX_LISTING_PHOTOS=20

# Push bildirimi: log (geliştirme) | memory (test) | fcm (üretim)
PUSH_PROVIDER=log
# FCM_SERVICE_ACCOUNT=           # PUSH_PROVIDER=fcm: Firebase servis hesabı JSON'u (ham veya base64)

# Ödeme: mock (Trinkle360 eklenene kadar). Üretimde ALLOW_MOCK_PAYMENTS=true olmadan açılmaz
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=dev-payment-webhook-secret
# Platform hizmet bedeli (on binde: 500 = %5) ve KDV (2000 = %20)
PLATFORM_FEE_BPS=500
VAT_RATE_BPS=2000
PAYMENT_LINK_DAYS=7
PUBLIC_WEB_URL=http://localhost:3001
